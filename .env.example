# ==============================================================================
# Alpha Decor & Paints - Environment Variables Configuration (.env.example)
# Do NOT place real secrets in this template.
# ==============================================================================

# Node Environment & Server Port
NODE_ENV="production"
PORT=3000

# Base Application URL (Injected by Cloud Run or set to your custom domain)
APP_URL="https://your-domain.com"

# ==============================================================================
# AI Provider Configuration (Google Gemini & Grok / xAI https://grok.com/)
# ==============================================================================
# Primary AI Provider: "gemini" (Rank 1 Default) or "grok" (Rank 2 Fallback)
AI_PROVIDER="gemini"

# Automatic fallback to Grok (https://grok.com/) when Gemini fails or is slow
AI_FALLBACK_ENABLED="true"

# Rank 1: Google Gemini AI API Key & Model
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-2.5-flash"

# Rank 2: Grok AI (xAI - https://grok.com/) API Key & Verified Models
# Official Website: https://grok.com/ | API: https://api.x.ai/v1/chat/completions
# Verified models: grok-2-latest, grok-2-1212, grok-beta, grok-vision-beta
GROK_API_KEY="xai-YourGrokApiKeyHere"
GROK_MODEL="grok-2-latest"

# Ultra-Fast Groq Alternative API Key (Optional)
GROQ_API_KEY="gsk_YourGroqApiKeyHere"
GROQ_MODEL="llama-3.3-70b-versatile"

# ==============================================================================
# Cloud SQL / PostgreSQL Database Connection (Option A: Unix Domain Socket / Cloud Run)
# ==============================================================================
# For Google Cloud Run with Cloud SQL connector:
# SQL_HOST="/cloudsql/YOUR_GCP_PROJECT:REGION:INSTANCE_NAME"
SQL_HOST="/cloudsql/project:region:instance"
SQL_DB_NAME="alpha_decor_database"
SQL_USER="alpha_app_user"
SQL_PASSWORD="YOUR_DATABASE_APP_PASSWORD"

# Dedicated Admin User for DDL Migrations (npm run db:migrate)
SQL_ADMIN_USER="alpha_admin_user"
SQL_ADMIN_PASSWORD="YOUR_DATABASE_ADMIN_PASSWORD"

# ==============================================================================
# PostgreSQL Connection (Option B: Standard TCP Host & Port / Remote Managed DB)
# ==============================================================================
# SQL_HOST="34.x.x.x"
# SQL_PORT=5432
# SQL_SSL="true"

# Or Single Connection String:
# DATABASE_URL="postgresql://alpha_user:password@hostname:5432/alpha_db?sslmode=require"

# ==============================================================================
# Security & Administrative Credentials
# ==============================================================================
# Mandatory strong password for owner (الحضرى محمود) initial bootstrap
ADMIN_PASSWORD="YOUR_SECURE_ADMIN_INITIAL_PASSWORD"

# Secret webhook key for authorized external cron triggers (Cloud Scheduler)
# If omitted, /api/cron/auto-publish will reject requests.
CRON_SECRET="YOUR_RANDOM_LONG_SECRET_KEY"

# ==============================================================================
# Social Media Publishing Bot Credentials (Optional)
# Note: Bot is deactivated by default (botState.enabled=false).
# Automatic background publishing is disabled by owner decree.
# Real credentials are required only when manually testing social dispatch.
# ==============================================================================
# Telegram Channel / Group Bot
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="@your_alpha_channel_or_chat_id"

# Facebook Page Graph API
FACEBOOK_PAGE_ACCESS_TOKEN="EAAxxxxxx..."
FACEBOOK_PAGE_ID="123456789012345"

# Twitter / X API v2 Credentials
TWITTER_API_KEY="your_twitter_api_key"
TWITTER_API_SECRET="your_twitter_api_secret"
TWITTER_ACCESS_TOKEN="your_twitter_access_token"
TWITTER_ACCESS_SECRET="your_twitter_access_secret"

